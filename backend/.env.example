# Ollama connection
OLLAMA_HOST=http://localhost:11434
# Any model you've pulled with `ollama pull` works — llama3:8b is a solid default for natural
# feedback/critique. `ollama list` to see what you have locally.
OLLAMA_MODEL=llama3:8b

# Where uploaded audio/MIDI files are stored
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
